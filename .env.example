# ==============================================================================
# SwasthaSathi Environment Configuration Template
# Copy to .env and configure your keys. NEVER commit the actual .env file.
# ==============================================================================

# 1. AI Engine (Groq LLM for Triage Assessment, Follow-ups, and Whisper Audio STT)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Supabase Cloud Configuration (Authentication, PostgreSQL Database & RLS)
# Replace with your Supabase project URL and public Anon key from:
# https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Frontend-compatible variables (for Vite / Next.js / Static Hosting environments)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# 3. Optional Port Configuration (default is 8080)
PORT=8080
